# =============================================================================
# API — variables de entorno
#
# Copiar a `.env` y rellenar. El `.env` está en .gitignore: nunca lo subas.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI (obligatorio)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-tu-api-key-aqui

# `openai_key` sigue aceptándose como alias legado, pero OPENAI_API_KEY tiene
# prioridad. No hace falta definir las dos.

# Solo si usas el backend Gemini de models/LanguageModels.py. Opcional.
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Seguridad / red
# -----------------------------------------------------------------------------
# Orígenes permitidos por CORS, separados por coma.
# Default si no se define: http://localhost:5173,http://127.0.0.1:5173
# NO uses "*": la API llama a OpenAI, y abierta a cualquier origen significa
# que cualquiera en la red puede gastar tu cuota.
# CORS_ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Token opcional. Si se define, /get_response exige `Authorization: Bearer <token>`.
# Sin esta variable la API queda ABIERTA (razonable solo en localhost).
# Defínelo SIEMPRE que expongas la API fuera de tu máquina.
# API_TOKEN=

# -----------------------------------------------------------------------------
# Rutas de documentos
# -----------------------------------------------------------------------------
# Carpeta con los PDF fuente. Usa una ruta absoluta de tu máquina.
DOC_BASE_DIR="/ruta/absoluta/a/unq_rag/Ingestion/data/raw_data"

# Planos que abre el selector de la app de escritorio (tkinterapp).
PLANOS_ELECTRICOS_URL="/ruta/absoluta/a/unq_rag/API/plano_distribucion_electrica.pdf"
PLANOS_CONEXIONADO_URL="/ruta/absoluta/a/unq_rag/API/conexionadoTben.pdf"

# -----------------------------------------------------------------------------
# Cliente de escritorio (API/tkinterapp) — opcional
# -----------------------------------------------------------------------------
# Endpoint al que apunta el cliente tkinter.
# API_URL=http://127.0.0.1:5000/get_response

# Base URL pública para construir enlaces a los documentos.
# Si se deja vacía, se usan rutas locales (DOC_BASE_DIR).
# DOC_BASE_URL=https://tu-dominio/static/docs
