# =============================================================================
# Frontend (Vite + React) — variables de entorno
#
# Copiar a `.env` y ajustar. El `.env` está en .gitignore: nunca lo subas.
#   cp .env.example .env
#
# AVISO: todo lo que empiece por VITE_ se INYECTA EN EL BUNDLE y es visible
# para cualquiera que abra la web. Nunca pongas aquí una API key ni un secreto.
# =============================================================================

# URL base de la API Flask. Sin barra final.
# En desarrollo local, la API corre en el puerto 5000.
VITE_API_BASE_URL=http://localhost:5000
