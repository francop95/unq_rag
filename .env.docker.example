# =============================================================================
# Variables que lee docker compose. Copiar a `.env` en la RAÍZ del repo:
#
#   cp .env.docker.example .env
#
# Este archivo es distinto de los .env de cada servicio:
#
#   .env (raíz)        → lo lee docker compose, para los contenedores
#   API/.env           → para correr la API a mano, fuera de Docker
#   Ingestion/.env     → lo lee el pipeline SIEMPRE, también dentro de Docker,
#                        porque ConfigReader usa dotenv_values() y eso lee el
#                        archivo, no el entorno. El compose lo monta.
#   Frontend/.env      → solo para `npm run dev`; en Docker las URLs son
#                        relativas y las resuelve nginx.
# =============================================================================

# -----------------------------------------------------------------------------
# Obligatorio
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-tu-api-key-aqui

# -----------------------------------------------------------------------------
# Puertos publicados en el host
# -----------------------------------------------------------------------------
# La aplicación (nginx). Es la única que hace falta abrir en el navegador.
WEB_PORT=8080

# Las APIs se publican para poder pegarles con curl o correr el eval desde el
# host. El frontend no las usa directo: entra por nginx.
API_PORT=5000
API_BASELINE_PORT=5001

# -----------------------------------------------------------------------------
# Seguridad
# -----------------------------------------------------------------------------
# Orígenes permitidos por CORS. Con el proxy de nginx el navegador va al mismo
# origen, así que esto solo importa si expones los puertos de las APIs a la red.
CORS_ALLOWED_ORIGIN=http://localhost:8080

# Si lo definís, /get_response exige `Authorization: Bearer <token>`.
# Vacío = API abierta, razonable en local. Ponelo siempre que la expongas.
API_TOKEN=

# -----------------------------------------------------------------------------
# Build
# -----------------------------------------------------------------------------
# 1 = la imagen de la API incluye torch + sentence-transformers, para el
# reranking cross-encoder y el retrieval visual CLIP. Suma ~2,5 GB.
#
# Dejalo en 0 salvo que vayas a poner USE_RERANKING o USE_VISUAL_RETRIEVAL en
# True en API/configs/Configuration.py. Hoy están en False porque se midieron y
# no mejoran el recall en este corpus; sin el paquete el código degrada solo
# (los imports están en try/except) y deja un warning en el log.
WITH_ML=0

# -----------------------------------------------------------------------------
# Índice de la línea base
# -----------------------------------------------------------------------------
BASELINE_INDEX_NAME=baseline_documents
