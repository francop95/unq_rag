# =============================================================================
# Ingestion — variables de entorno
#
# Copiar a `.env` y ajustar. El `.env` está en .gitignore: nunca lo subas.
#   cp .env.example .env
#
# Todas las variables son OPCIONALES salvo `openai_key`: lo que no se define
# usa el valor por defecto de src/config/config_reader.py, que es el que se
# indica aquí en cada línea.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI (obligatorio)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-tu-api-key-aqui

# `openai_key` (pipeline) y `OPEN_AI_KEY` (tests/test_search_openai.py) siguen
# aceptándose como alias legados, pero OPENAI_API_KEY tiene prioridad.
# No hace falta definir varias.

# Endpoint alternativo (proxy, Azure, LiteLLM...). Vacío = API oficial de OpenAI.
# openai_url=

# -----------------------------------------------------------------------------
# Rutas de datos
# -----------------------------------------------------------------------------
raw_data_path=./data/raw_data/
chunks_data_path=./data/chunks_data/
embeddings_data_path=./data/embeddings_data/
index_path=./data/chroma_index/
media_path=./data/media

# -----------------------------------------------------------------------------
# Índice Chroma
# -----------------------------------------------------------------------------
index_name=verion_index
# hnsw_space=cosine          # métrica: cosine | l2 | ip
# hnsw_search_ef=100         # mayor = búsqueda más exhaustiva y más lenta
# index_batch_size=512

# -----------------------------------------------------------------------------
# Chunking (extracción multimodal del PDF)
# -----------------------------------------------------------------------------
# multimodal_model=gpt-4o
# chunking_temperature=0.2
# chunking_max_output_tokens=4000
# pdf_zoom=2.0               # factor de rasterizado del PDF
# chunking_concurrency=4     # páginas en paralelo; acotado por rate limits

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# embedding_model=text-embedding-3-large
# embedding_batch_size=64
# embedding_max_retries=5

# -----------------------------------------------------------------------------
# Chunking híbrido y validación
# -----------------------------------------------------------------------------
use_hybrid_chunking=true
complexity_threshold=0.5
chunk_size=1000
chunk_overlap=200
max_table_rows=10
min_chunk_length=50
max_chunk_length=8000
similarity_threshold=0.85

# OCR de diagramas (requiere tesseract instalado en el sistema)
use_ocr_for_diagrams=true
ocr_confidence_threshold=60.0

# Re-chunking semántico
semantic_similarity_threshold=0.85
max_pages_gap=2
max_superchunk_size=3000

# -----------------------------------------------------------------------------
# Índice visual (dual)
# -----------------------------------------------------------------------------
clip_model=clip-ViT-B-32
visual_index_name=visual_docs

# -----------------------------------------------------------------------------
# Retrieval avanzado
# -----------------------------------------------------------------------------
use_reranking=true
reranker_model=cross-encoder/ms-marco-MiniLM-L-6-v2
rerank_top_k=20

use_bm25=true
bm25_weight=0.3

use_query_expansion=true
max_expanded_terms=3

use_context_expansion=true
context_window_size=1

# -----------------------------------------------------------------------------
# Enriquecimiento por LLM
#
# Sube el costo de la ingesta (llamadas extra al LLM) a cambio de mejor
# retrieval. Ponlo en false si solo quieres una pasada rápida y barata.
# -----------------------------------------------------------------------------
use_contextual_retrieval=true
use_synthetic_questions=true
max_synthetic_questions=8
enrichment_model=gpt-4o-mini
enrichment_concurrency=4

use_dedicated_figure_pass=true
figure_pass_concurrency=3
